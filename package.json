{
  "name": "forteflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@forteflow/web",
    "dev:api": "npm run dev --workspace=@forteflow/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@forteflow/web",
    "build:api": "npm run build --workspace=@forteflow/api",
    "lint": "eslint .",
    "preview": "npm run preview --workspace=@forteflow/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.13.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
